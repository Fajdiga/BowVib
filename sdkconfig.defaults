# BowVib - ESP32-C6-MINI-1-H8 + four LSM6DSV320X
CONFIG_IDF_TARGET="esp32c6"

# C6 is single-core and the H8 module has 8 MB flash, no PSRAM.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The schematic uses GPIO16/17 as sensor chip-selects. Keep console logs off
# UART0, and keep USB Serial/JTAG free of text while binary capture is active.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
